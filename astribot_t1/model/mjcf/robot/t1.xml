<?xml version="1.0"?>
<mujoco model="astribot_t1">
    <compiler angle="radian" meshdir="../../mesh" />
    <option impratio="100" integrator="implicit" timestep="0.005" viscosity="0.1" gravity="0 0 -9.81" />
    <include file="assets.xml" />
    <worldbody>
        <body name="chassis_base" pos="0 0 0" euler="0 0 0">
            <freejoint name="chassis_free" />
            <!-- SDK chassis frame; the physical torso is welded at z=56.2 mm. -->
            <body name="physical_torso_base" pos="0 0 0.0562">
                <include file="kinematic.xml" />
                <include file="sensors/lidar_mid360_front.xml" />
                <include file="sensors/chassis_rear_d405.xml" />
            </body>
        </body>
    </worldbody>
    <include file="sensors/imu_front.xml" />
    <include file="sensors/imu_chassis.xml" />
    <include file="actuator_chassis.xml" />
    <include file="actuator_base.xml" />
</mujoco>

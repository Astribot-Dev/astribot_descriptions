          <ixz>4e-08</ixz>
          <iyy>4.789e-05</iyy>
          <iyz>-9.1e-07</iyz>
          <izz>3.779e-05</izz>
        </inertia>
      </inertial>
    </link>
    <joint name='astribot_head_joint_2' type='revolute'>
      <pose relative_to='astribot_head_link_1'>0 0 0 -1.5708 0 0</pose>
      <parent>astribot_head_link_1</parent>

          <izz>0.0</izz>
        </inertia>
      </inertial>
    </link>
    <joint name='astribot_head_joint_1' type='revolute'>
      <pose relative_to='astribot_head_base_link'>0 0 0 0 -0 0</pose>
      <parent>astribot_head_base_link</parent>
      <child>astribot_head_link_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.6</lower>
          <upper>1.6</upper>
          <effort>21.28</effort>
          <velocity>15.11</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='astribot_head_link_1'>
      <pose relative_to='astribot_head_joint_1'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>0.07444791 0.03404337 -0.14889563 0 -0 0</pose>
        <mass>0.1868499</mass>
        <inertia>
          <ixx>4.567e-05</ixx>

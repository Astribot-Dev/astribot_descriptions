<?xml version="1.0"?>
<sdf version='1.7'>
  <model name='astribot_head'>
    <link name="base">
     <inertial>
      <mass>0.0</mass>
       <inertia>
        <ixx>0</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0</iyy>
        <iyz>0</iyz>
        <izz>0</izz>
      </inertia>
     </inertial>
    </link>
    <!--joint between {parent} and link_0-->
    <joint name="base_joint" type="fixed">
      <child>astribot_head_base_link</child>
      <parent>base</parent>
    </joint>
    <link name='astribot_head_base_link'>
      <inertial>
        <pose>0.0 0.0 0.0 0 -0 0</pose>
        <mass>0.0</mass>

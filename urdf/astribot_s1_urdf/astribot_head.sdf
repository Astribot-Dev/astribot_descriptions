        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='astribot_head_link_2'>
    <!-- todo: This is just for adapting to the old version of kinodynamic line 33-->
      <pose relative_to='astribot_head_joint_2'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>0.02119279 -0.19825652 -0.00084482 0 -0 0</pose>
        <mass>0.87099978</mass>
